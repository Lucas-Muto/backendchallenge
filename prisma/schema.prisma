generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Traveler {
  id             Int          @id @default(autoincrement())
  name           String
  birthDate      DateTime
  passportNumber String       @unique
  infractions    Infraction[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Infraction {
  id             Int      @id @default(autoincrement())
  description    String
  dateTime       DateTime
  severity       String
  traveler       Traveler @relation(fields: [passportNumber], references: [passportNumber])
  passportNumber String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
} 