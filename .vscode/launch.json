{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Current Test File",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": [
                "${fileBasename}",
                "--runInBand",
                "--watchAll=false",
                "--testTimeout=100000"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
} 